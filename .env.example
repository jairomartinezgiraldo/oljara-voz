# Modelo de Whisper: tiny | base | small | medium | large-v3
WHISPER_MODEL=medium

# Dispositivo: auto | cpu | cuda
WHISPER_DEVICE=auto

# URL de Ollama (usa host.docker.internal dentro de Docker)
OLLAMA_URL=http://host.docker.internal:11434

# Modelo LLM en Ollama
OLLAMA_MODEL=llama3

# Tamaño máximo de archivo en MB
MAX_FILE_MB=200
